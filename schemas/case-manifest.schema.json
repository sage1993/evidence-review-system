{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ansim.local/schemas/case-manifest.schema.json",
  "title": "Case Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "case_id",
    "policy_id",
    "sources",
    "quality_assessments",
    "candidates",
    "confirmations",
    "confirmed_inputs_path",
    "confirmed_inputs_sha256"
  ],
  "properties": {
    "format": {"const": "ansim/case-manifest"},
    "version": {"const": 1},
    "case_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "policy_id": {"type": "string", "minLength": 1},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "quality_assessments": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "confirmations": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "confirmed_inputs_path": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"}
      ]
    },
    "confirmed_inputs_sha256": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "relative_path", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "relative_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
