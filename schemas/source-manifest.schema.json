{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ansim-review.local/schemas/source-manifest.schema.json",
  "title": "Evidence source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_id", "revision_id", "relative_path", "source_hash", "byte_size", "page_count", "parser_artifacts"],
  "properties": {
    "document_id": {"type": "string", "minLength": 1},
    "revision_id": {"type": "string", "minLength": 14},
    "relative_path": {"type": "string", "minLength": 1},
    "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "byte_size": {"type": "integer", "minimum": 1},
    "page_count": {"type": "integer", "minimum": 1},
    "parser_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relative_path", "byte_size", "sha256"],
        "properties": {
          "relative_path": {"type": "string", "minLength": 1},
          "byte_size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
