{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ansim-review.local/schemas/immutable-attachment.schema.json",
  "title": "Immutable attachment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attachment_id",
    "original_name",
    "stored_path",
    "sha256",
    "byte_size",
    "mime",
    "role"
  ],
  "properties": {
    "attachment_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "original_name": {"type": "string", "minLength": 1},
    "stored_path": {
      "type": "string",
      "pattern": "^(inputs/original/[^/]+|cases/[^/]+/sources/drawings/[^/]+)$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "byte_size": {"type": "integer", "minimum": 1},
    "mime": {"type": "string", "minLength": 1},
    "role": {
      "enum": [
        "REFERENCE_DOCUMENT",
        "CASE_DRAWING",
        "CASE_TABLE",
        "SUPPORTING_IMAGE"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stored_path": {
            "pattern": "^cases/"
          }
        },
        "required": ["stored_path"]
      },
      "then": {
        "required": ["case_id"],
        "properties": {
          "role": {
            "enum": ["CASE_DRAWING", "SUPPORTING_IMAGE"]
          }
        }
      },
      "else": {
        "not": {
          "required": ["case_id"]
        }
      }
    }
  ]
}
