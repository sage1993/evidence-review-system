{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sage1993/evidence-review-system/schemas/parser-warning-report.schema.json",
  "title": "Parser Warning Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "source_sha256",
    "parser_version",
    "configuration_sha256",
    "warnings"
  ],
  "properties": {
    "format": {"const": "evidence-review/parser-warning-report"},
    "version": {"const": 1},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "parser_version": {"type": "string", "minLength": 1},
    "configuration_sha256": {"$ref": "#/$defs/sha256"},
    "warnings": {
      "type": "array",
      "items": {"$ref": "#/$defs/warning"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warning_id",
        "severity",
        "code",
        "document_id",
        "revision_id",
        "source_sha256",
        "parser_kind",
        "parser_version",
        "configuration_sha256",
        "page_number",
        "raw_source_relative_path",
        "raw_location",
        "raw_message",
        "normalized_message_sha256",
        "run_id"
      ],
      "properties": {
        "warning_id": {"type": "string", "pattern": "^PWRN-[0-9A-F]{24}$"},
        "severity": {"const": "WARNING"},
        "code": {
          "enum": [
            "PARSER_WARNING_TEXT_EXTRACTION",
            "PARSER_WARNING_TABLE_EXTRACTION",
            "PARSER_WARNING_IMAGE_EXTRACTION",
            "PARSER_WARNING_LAYOUT",
            "PARSER_WARNING_PAGE",
            "PARSER_WARNING_UNKNOWN"
          ]
        },
        "document_id": {"type": "string", "minLength": 1},
        "revision_id": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "parser_kind": {"const": "opendataloader"},
        "parser_version": {"type": "string", "minLength": 1},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "page_number": {"type": ["integer", "null"], "minimum": 1},
        "raw_source_relative_path": {"type": "string", "minLength": 1},
        "raw_location": {"type": "string", "minLength": 1},
        "raw_message": {"type": "string"},
        "normalized_message_sha256": {"$ref": "#/$defs/sha256"},
        "run_id": {"type": "string", "pattern": "^PRUN-[0-9A-F]{24}$"}
      }
    }
  }
}
