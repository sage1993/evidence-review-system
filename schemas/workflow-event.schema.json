{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence-review.local/schemas/workflow-event.schema.json",
  "title": "Evidence Review Workflow Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "run_id",
    "sequence",
    "event_id",
    "kind",
    "previous_state",
    "next_state",
    "finalizer_status",
    "reason_codes",
    "resumable",
    "payload_sha256",
    "recorded_at"
  ],
  "properties": {
    "format": {
      "const": "evidence-review/workflow-event"
    },
    "version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "kind": {
      "enum": [
        "TRANSITION",
        "RESUME"
      ]
    },
    "previous_state": {
      "oneOf": [
        {
          "$ref": "#/$defs/workflow_state"
        },
        {
          "type": "null"
        }
      ]
    },
    "next_state": {
      "$ref": "#/$defs/workflow_state"
    },
    "finalizer_status": {
      "enum": [
        "READY_FOR_HUMAN_REVIEW",
        "ABSTAIN",
        null
      ]
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reason_code"
      }
    },
    "resumable": {
      "type": "boolean"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "workflow_state": {
      "enum": [
        "RECEIVED",
        "CLASSIFYING_INPUTS",
        "ROLE_CONFIRMATION_REQUIRED",
        "PENDING_REFERENCE_INGESTION",
        "PENDING_DRAWING_INGESTION",
        "INPUT_CONFIRMATION_REQUIRED",
        "READY_TO_EVALUATE",
        "RETRIEVING_EVIDENCE",
        "RUNNING_MATH",
        "RUNNING_RULES",
        "WAITING_TRACK_A",
        "WAITING_TRACK_B",
        "FINALIZING",
        "READY_FOR_REVIEW",
        "BLOCKED",
        "FAILED"
      ]
    },
    "reason_code": {
      "enum": [
        "SOURCE_CONFLICT",
        "SOURCE_HASH_MISMATCH",
        "MISSING_REQUIRED_INPUT",
        "UNAPPROVED_RULE",
        "MISSING_FORMULA",
        "STALE_SNAPSHOT",
        "MATH_ENGINE_ERROR",
        "CITATION_AUDIT_FAILED",
        "TRACK_B_REJECTED",
        "ROLE_CONFIRMATION_REQUIRED",
        "DRAWING_QUALITY_REJECTED",
        "DRAWING_CONFIRMATION_REQUIRED"
      ]
    }
  }
}
