{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ansim-review.local/schemas/drawing-geometry.schema.json",
  "title": "Drawing geometry",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinate_system", "coordinates"],
      "properties": {
        "type": {"const": "POINT"},
        "coordinate_system": {"enum": ["PDF_BOTTOM_LEFT_POINTS", "IMAGE_TOP_LEFT_PIXELS"]},
        "coordinates": {
          "type": "array",
          "prefixItems": [{"type": "number"}, {"type": "number"}],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinate_system", "coordinates"],
      "properties": {
        "type": {"const": "BBOX"},
        "coordinate_system": {"enum": ["PDF_BOTTOM_LEFT_POINTS", "IMAGE_TOP_LEFT_PIXELS"]},
        "coordinates": {
          "type": "array",
          "prefixItems": [
            {"type": "number"},
            {"type": "number"},
            {"type": "number"},
            {"type": "number"}
          ],
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinate_system", "coordinates"],
      "properties": {
        "type": {"const": "LINESTRING"},
        "coordinate_system": {"enum": ["PDF_BOTTOM_LEFT_POINTS", "IMAGE_TOP_LEFT_PIXELS"]},
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "prefixItems": [{"type": "number"}, {"type": "number"}],
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinate_system", "coordinates"],
      "properties": {
        "type": {"const": "POLYGON"},
        "coordinate_system": {"enum": ["PDF_BOTTOM_LEFT_POINTS", "IMAGE_TOP_LEFT_PIXELS"]},
        "coordinates": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "array",
            "prefixItems": [{"type": "number"}, {"type": "number"}],
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    }
  ]
}
