{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence-review.local/schemas/visual-manifest.schema.json",
  "title": "Explicit visual evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "records"],
  "properties": {
    "format": {"const": "evidence-review/visual-manifest"},
    "version": {"const": 1},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "document_id",
          "revision_id",
          "page_id",
          "kind",
          "path",
          "sha256",
          "bbox",
          "source_evidence_ids"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "document_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "revision_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "page_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "kind": {
            "enum": ["unique_image", "occurrence_crop", "table_crop", "composite_diagram", "page_render"]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)(?!.*\\\\).+$"
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bbox": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {"type": "number"}
              }
            ]
          },
          "source_evidence_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
