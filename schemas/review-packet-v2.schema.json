{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ansim-review.local/schemas/review-packet-v2.schema.json",
  "title": "Review Packet v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "run_id",
    "case_id",
    "question",
    "finalizer_status",
    "snapshot_sha256",
    "rule_manifest_sha256",
    "formula_manifest_sha256",
    "claims",
    "evidence",
    "drawing_evidence",
    "confirmed_inputs",
    "calculations",
    "rule_evaluations",
    "exceptions",
    "conflicts",
    "confidence",
    "abstention_reasons",
    "human_decision",
    "compatibility_source_version"
  ],
  "properties": {
    "format": {"const": "ansim/review-packet"},
    "version": {"const": 2},
    "run_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "finalizer_status": {"enum": ["READY_FOR_HUMAN_REVIEW", "ABSTAIN"]},
    "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rule_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "formula_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "text", "citation_ids", "numeric_tokens"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "citation_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "numeric_tokens": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "citation", "quote", "numeric_tokens"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "citation": {"$ref": "#/$defs/citation"},
          "quote": {"type": "string", "minLength": 1},
          "numeric_tokens": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "drawing_evidence": {
      "type": "array",
      "items": {"$ref": "drawing-candidate.schema.json"}
    },
    "confirmed_inputs": {
      "type": "array",
      "items": {"$ref": "confirmed-input.schema.json"}
    },
    "calculations": {"type": "array", "items": {"type": "object"}},
    "rule_evaluations": {"type": "array", "items": {"type": "object"}},
    "exceptions": {"type": "array", "items": {"type": "string"}},
    "conflicts": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": ["object", "null"]},
    "abstention_reasons": {"type": "array", "items": {"type": "string"}},
    "human_decision": {"type": "null"},
    "compatibility_source_version": {
      "oneOf": [{"type": "null"}, {"const": 1}]
    }
  },
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation_id",
        "document_id",
        "revision_id",
        "page_number",
        "evidence_id",
        "bbox",
        "source_hash"
      ],
      "properties": {
        "citation_id": {"type": "string", "minLength": 1},
        "document_id": {"type": "string", "minLength": 1},
        "revision_id": {"type": "string", "minLength": 1},
        "page_number": {"type": "integer", "minimum": 1},
        "evidence_id": {"type": "string", "minLength": 1},
        "bbox": {
          "type": "array",
          "prefixItems": [
            {"type": "number"},
            {"type": "number"},
            {"type": "number"},
            {"type": "number"}
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
