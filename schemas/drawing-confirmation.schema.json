{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ansim-review.local/schemas/drawing-confirmation.schema.json",
  "title": "Drawing confirmation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "confirmation_id",
    "candidate_id",
    "action",
    "source_sha256",
    "reviewer",
    "confirmed_at",
    "confirmed_value",
    "unit",
    "geometry"
  ],
  "properties": {
    "confirmation_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "action": {"enum": ["ACCEPTED", "REJECTED", "EDITED", "CREATED"]},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewer": {"type": "string", "minLength": 1},
    "confirmed_at": {"type": "string", "minLength": 1},
    "confirmed_value": {"type": ["string", "null"]},
    "unit": {"type": ["string", "null"]},
    "geometry": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "drawing-geometry.schema.json"}
      ]
    }
  }
}
